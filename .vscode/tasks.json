{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Saarthi: install dependencies",
      "type": "shell",
      "command": "python -m venv .venv ; .venv/Scripts/python.exe -m pip install -r requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "Saarthi: start server",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m uvicorn app.main:app --port 8010 --reload",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Saarthi: run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
