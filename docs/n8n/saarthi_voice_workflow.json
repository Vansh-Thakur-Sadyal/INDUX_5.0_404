        "options": {}
      },
      "id": "d4000000-0000-4000-8000-000000000003",
      "name": "Saarthi: record call status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [60, 420]
    }
