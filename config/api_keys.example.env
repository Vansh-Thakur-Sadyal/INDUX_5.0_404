# =====================================================================
#  SAARTHI 2.0  —  SINGLE CREDENTIALS FILE
#  InduX 5.0 | Problem Statement 16 | Team VisionCoders (InduX5-26VU-404)
# ---------------------------------------------------------------------
#  This is the ONLY file you edit to plug credentials in.
#  Everything (LLM, RAG, speech, telephony, market data) reads from here.
#  Blank value or a "..._here" placeholder = NOT CONFIGURED; the app will
#  say so on /api/keys/status and on the dashboard instead of pretending.
#  Restart the backend after editing.  Never commit this file.
# =====================================================================

# ---------------------------------------------------------------------
# 1. MISTRAL  — LLM (answer generation, intent, translation) + embeddings
#    for RAG.  Get a key: https://console.mistral.ai/api-keys
#    Without it: RAG still retrieves (offline deterministic embeddings)
#    and the 15 agents still run (they are rule/data driven), but no
#    natural-language answer is generated — the API says so explicitly.
# ---------------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed

# ---------------------------------------------------------------------
# 2. AZURE SPEECH  — multilingual STT + TTS for the voice chatbot and
#    for telephony audio.  Azure portal -> Create resource -> Speech.
#    Copy KEY 1 and the Location/Region (e.g. centralindia, eastus).
#    The text chatbot works WITHOUT this; only voice needs it.
# ---------------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# ---------------------------------------------------------------------
# 3. TELEPHONY VIA n8n  — Twilio credentials live in n8n on the VPS;
#    Saarthi never holds a Twilio token.  Saarthi POSTs to these n8n
#    webhooks and n8n places/controls the Twilio call.
#    N8N_BASE_URL example: https://n8n-kmar.srv1804200.hstgr.cloud
#    Paths are appended to the base url (or give absolute URLs).
# ---------------------------------------------------------------------
N8N_BASE_URL=
N8N_OUTBOUND_CALL_PATH=/webhook/saarthi-outbound-call
N8N_CALL_STATUS_PATH=/webhook/saarthi-call-status
N8N_WEBHOOK_TOKEN=
# Shared secret n8n must send back on inbound call webhooks (X-Saarthi-Token)
SAARTHI_INBOUND_TOKEN=change-me-inbound-secret
# Helpline number shown on the dashboard (the Twilio number configured in n8n)
SAARTHI_HELPLINE_NUMBER=

# ---------------------------------------------------------------------
# 4. DATA.GOV.IN  — live Agmarknet mandi prices (Agent 12).
#    Free key at https://data.gov.in . Without it, market answers say
#    "live market data unavailable" instead of inventing prices.
# ---------------------------------------------------------------------
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# ---------------------------------------------------------------------
# 5. OPTIONAL — MongoDB Atlas Vector Search backend for RAG.
#    Leave blank to use the built-in local vector store (default, no
#    external service, works offline).
# ---------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=saarthi
MONGODB_VECTOR_COLLECTION=kb_vectors

# ---------------------------------------------------------------------
# 6. SERVER
# ---------------------------------------------------------------------
SAARTHI_PORT=8010
SAARTHI_HOST=127.0.0.1
# Public base URL of this backend, used when handing audio URLs to n8n/Twilio.
SAARTHI_PUBLIC_URL=
